{%- comment -%}
  Organization JSON-LD, site-wide.
  Gebruikt dezelfde bron als het NAP-blok (settings.gmc_*), zodat
  structured data en zichtbare tekst nooit uit de pas lopen.
  Rendert alleen als bedrijfsnaam + straat zijn ingevuld en de
  toggle "gmc_show_schema_org" aan staat.
{%- endcomment -%}

{%- liquid
  assign company_name = settings.gmc_company_name | default: '' | strip
  assign address_line1 = settings.gmc_address_line1 | default: '' | strip
-%}

{%- if settings.gmc_show_schema_org and company_name != '' and address_line1 != '' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ settings.gmc_company_name | json }},
      "url": {{ request.origin | json }},
      {%- if settings.gmc_phone != blank -%}
      "telephone": {{ settings.gmc_phone | json }},
      {%- endif -%}
      {%- if settings.gmc_email != blank -%}
      "email": {{ settings.gmc_email | json }},
      {%- endif -%}
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ settings.gmc_address_line1 | json }}
        {%- if settings.gmc_address_line2 != blank -%}, "addressLine2": {{ settings.gmc_address_line2 | json }}{%- endif -%}
        {%- if settings.gmc_address_city != blank -%}, "addressLocality": {{ settings.gmc_address_city | json }}{%- endif -%}
        {%- if settings.gmc_address_region != blank -%}, "addressRegion": {{ settings.gmc_address_region | json }}{%- endif -%}
        {%- if settings.gmc_address_zip != blank -%}, "postalCode": {{ settings.gmc_address_zip | json }}{%- endif -%}
        {%- if settings.gmc_address_country != blank -%}, "addressCountry": {{ settings.gmc_address_country | json }}{%- endif -%}
      }
    }
  </script>
{%- endif -%}
