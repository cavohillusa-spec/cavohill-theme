{{ 'component-nap-block.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- render 'nap-block' -%}

    {%- liquid
      assign has_name = settings.gmc_company_name | default: '' | strip
      assign has_address = settings.gmc_address_line1 | default: '' | strip
    -%}
    {%- if has_name == '' and has_address == '' -%}
      <p class="nap-info__empty-state">
        Bedrijfsgegevens nog niet ingevuld — vul ze in bij Theme Settings &gt; Company / GMC info (NAP).
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Company / GMC info (NAP)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Toont de centrale bedrijfsgegevens uit Theme Settings > Company / GMC info. Voeg deze sectie toe op About us, Contact, of elke andere pagina waar GMC een zichtbaar adres/contact verwacht."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Business details"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Klein" },
        { "value": "h1", "label": "Gemiddeld" },
        { "value": "h0", "label": "Groot" }
      ],
      "default": "h2",
      "label": "Titelgrootte"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Ruimte"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Ruimte boven",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Ruimte onder",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Company / GMC info (NAP)"
    }
  ]
}
{% endschema %}
