{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    {% # theme-check-disable %}
    data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
    {% # theme-check-enable %}
    {{ block.shopify_attributes }}
  >
    {%- liquid
      # Let op: hoeveel varianten hebben een eigen foto? Zonder eigen
      # variantfoto's heeft een fotoswatch geen zin en vallen we terug op de
      # gewone knoppen.
      assign variant_media_count = product.variants | map: 'featured_media' | compact | size
    -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif

        # De kleuroptie tonen we als fotoswatches: per kleur de foto van de
        # bijbehorende variant, met naam en prijs eronder. Andere opties
        # (Size) houden gewoon hun knoppen.
        assign option_name_downcase = option.name | downcase
        if variant_media_count > 0
          if option_name_downcase == 'color'
            assign picker_type = 'photo'
          elsif option_name_downcase == 'colour'
            assign picker_type = 'photo'
          elsif option_name_downcase == 'kleur'
            assign picker_type = 'photo'
          endif
        endif
      -%}
      {%- if picker_type == 'photo' -%}
        {%- comment -%}
          Is er maar één kleur, dan valt er niets te kiezen en tonen we de
          swatch niet. We laten het veld wél in de pagina staan (onzichtbaar,
          zie harbor-hudson.css): de radio blijft aangevinkt, zodat Dawn de
          juiste variant blijft samenstellen en de winkelwagen klopt.
        {%- endcomment -%}
        <fieldset
          class="js product-form__input product-form__input--photo{% if option.values.size == 1 %} product-form__input--photo-single{% endif %}"
        >
          <legend class="form__label">
            {{ option.name }}
            {%- comment -%}
              De gekozen waarde staat al leesbaar op het kaartje zelf, dus het
              label blijft kaal. Deze span houden we wel: Dawn schrijft er de
              gekozen kleur in, en zo horen schermlezers de wissel.
            {%- endcomment -%}
            <span class="visually-hidden" data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {%- comment -%}
            Eigen wikkel om de kaartjes. Nodig omdat de rij niet meer mag
            wrappen: zonder wikkel zou de legend als flex-item náást de
            kaartjes op dezelfde regel belanden.
          {%- endcomment -%}
          <div class="hh-photo-swatch-row">
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type
            %}
          </div>
        </fieldset>
      {%- elsif picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">{{ option.name }}</legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
